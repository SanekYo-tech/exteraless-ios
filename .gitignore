# Сборки и генерация (только в корне репо — не трогать исходники vendored-дерева!)
/build/
**/__pycache__/
*.pyc

# Артефакты сборки C-моста
python/bridge/build/
python/bridge/*.pyd
python/bridge/*.so

# Корпус и внешние клоны (восстанавливаются скриптами, см. README)
third_party/corpus-sources/
third_party/corpus/

# Bazel (симлинки в корне рабочей области)
/bazel-*
telegram-ios/build/artifacts/

# macOS/IDE
.DS_Store
*.xcuserstate
.idea/
.vscode/

# Секреты и локальные ключи
local.properties
*.keystore
*.p12
*.mobileprovision

# ...но фейковые фикстуры upstream-сборки — не секреты, они должны жить в git
!telegram-ios/build-system/fake-codesigning/**
!telegram-ios/buildbox/fake-codesigning/**

# Эталонная IPA и внешние study-клоны
reference-ipa/
third_party/Python-Apple-support/
third_party/Python-Apple-support-3.12/

diff --git a/swift/ExteralessCore/Sources/ExteralessCore/ToolsPluginSchemaCache.swift b/swift/ExteralessCore/Sources/ExteralessCore/ToolsPluginSchemaCache.swift
--- a/swift/ExteralessCore/Sources/ExteralessCore/ToolsPluginSchemaCache.swift
+++ b/swift/ExteralessCore/Sources/ExteralessCore/ToolsPluginSchemaCache.swift
@@ -62,8 +62,12 @@
     /// a filename, never a plugin display name or a path supplied by an archive.
     public static func settingsFileName(pluginId: String) throws -> String {
         guard (2...32).contains(pluginId.utf8.count), let first = pluginId.utf8.first,
-              (65...90).contains(first) || (97...122).contains(first),
-              pluginId.utf8.allSatisfy({ (65...90).contains($0) || (97...122).contains($0) || (48...57).contains($0) || $0 == 95 || $0 == 45 }) else {
+              pluginId.lowercased() != "exteralessmetadatainspector" else { throw ToolsError.unsafePath }
+        let letterFirst = (65...90).contains(first) || (97...122).contains(first)
+        // Native service IDs are the union of source and Elyx grammars. A
+        // digit/underscore-first Elyx ID cannot contain a source-only hyphen.
+        guard pluginId.utf8.allSatisfy({ (65...90).contains($0) || (97...122).contains($0)
+            || (48...57).contains($0) || $0 == 95 || (letterFirst && $0 == 45) }) else {
             throw ToolsError.unsafePath
         }
         return pluginId + "-" + pluginId.utf8.map { String(format: "%02x", $0) }.joined() + ".json"
diff --git a/swift/ExteralessCore/Tests/ExteralessCoreTests/ToolsArchiveIDCodecTests.swift b/swift/ExteralessCore/Tests/ExteralessCoreTests/ToolsArchiveIDCodecTests.swift
new file mode 100644
--- /dev/null
+++ b/swift/ExteralessCore/Tests/ExteralessCoreTests/ToolsArchiveIDCodecTests.swift
@@ -0,0 +1,16 @@
+import XCTest
+@testable import ExteralessCore
+
+final class ToolsArchiveIDCodecTests: XCTestCase {
+    func testArchiveIDsUseTheExistingNativeSettingsComponent() throws {
+        XCTAssertEqual(try ToolsPluginSchemaCache.settingsFileName(pluginId: "12"), "12-3132.json")
+        XCTAssertEqual(try ToolsPluginSchemaCache.settingsFileName(pluginId: "_p"), "_p-5f70.json")
+        XCTAssertEqual(try ToolsPluginSchemaCache.settingsFileName(pluginId: "__"), "__-5f5f.json")
+        XCTAssertNoThrow(try ToolsPluginSchemaCache.settingsFileName(pluginId: "a-b"))
+        XCTAssertNotEqual(try ToolsPluginSchemaCache.settingsFileName(pluginId: "Case").lowercased(),
+                          try ToolsPluginSchemaCache.settingsFileName(pluginId: "case").lowercased())
+        for id in ["a", "1-b", "_a-b", "../ab", "a.b", "exteralessMetadataInspector"] {
+            XCTAssertThrowsError(try ToolsPluginSchemaCache.settingsFileName(pluginId: id))
+        }
+    }
+}

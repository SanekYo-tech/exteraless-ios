+    #[cfg(target_os = "ios")]
+    if let Ok(name) = std::ffi::CString::new(host) {
+        let mut output = [0u8; 2048];
+        // SAFETY: name, output and the borrowed cancelled flag stay live until
+        // this synchronous call returns (the resolver worker owns a cloned Arc).
+        // Native code copies the CString, writes at most output.len() bytes and
+        // polls lookup_cancelled only before returning. Its asynchronous MTSignal
+        // callbacks retain no Rust pointers, including the cancellation context.
+        let count = unsafe {
+            MTAppNetworkResolve(
+                name.as_ptr(), port, output.as_mut_ptr(), output.len(), lookup_cancelled,
+                (cancelled as *const AtomicBool).cast(),
+            )
+        };
+        if count < 0 || count as usize > output.len() {
+            return Vec::new();
+        }
+        if count > 0 {
+            let Ok(text) = std::str::from_utf8(&output[..count as usize]) else {
+                return Vec::new();
+            };
+            return text.lines().filter_map(|text| {
+                if let Some((ip, scope)) = text.rsplit_once('%') {
+                    return Some(SocketAddr::V6(std::net::SocketAddrV6::new(ip.parse().ok()?, port, 0, scope.parse().ok()?)));
+                }
+                text.parse::<IpAddr>().ok().map(|ip| SocketAddr::new(ip, port))
+            }).take(16).collect();
+        }
+    }

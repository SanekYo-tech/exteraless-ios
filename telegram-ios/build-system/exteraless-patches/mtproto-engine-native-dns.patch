+use std::sync::atomic::{AtomicBool, Ordering};
+
+#[cfg(target_os = "ios")]
+// SAFETY: These signatures match MTAppNetworkResolver.h/.m. The char output is
+// a byte buffer, and the C bool callback is used only during the synchronous call.
+unsafe extern "C" {
+    fn MTAppNetworkResolve(
+        host: *const std::ffi::c_char,
+        port: u16,
+        output: *mut u8,
+        capacity: usize,
+        cancelled: extern "C" fn(*const std::ffi::c_void) -> bool,
+        context: *const std::ffi::c_void,
+    ) -> i32;
+    fn MTAppNetworkResolverEpoch() -> u64;
+    fn MTAppNetworkResolverCacheLifetime(host: *const std::ffi::c_char, port: u16) -> f64;
+}
+
+pub(super) fn policy_epoch() -> u64 {
+    #[cfg(target_os = "ios")]
+    {
+        // SAFETY: The native function only reads a process-lifetime atomic u64;
+        // it accepts no pointers and may be called from any engine thread.
+        unsafe { MTAppNetworkResolverEpoch() }
+    }
+    #[cfg(not(target_os = "ios"))]
+    {
+        0
+    }
+}
+
+pub(super) fn cache_lifetime(host: &str, port: u16, fallback: f64) -> f64 {
+    #[cfg(target_os = "ios")]
+    if let Ok(host) = std::ffi::CString::new(host) {
+        // SAFETY: host is a live, NUL-terminated CString. The native function
+        // copies it into an NSString before querying the TTL and retains no pointer.
+        let ttl = unsafe { MTAppNetworkResolverCacheLifetime(host.as_ptr(), port) };
+        if ttl.is_finite() && ttl >= 0.0 {
+            return ttl.min(fallback);
+        }
+    }
+    #[cfg(not(target_os = "ios"))]
+    let _ = (host, port);
+    fallback
+}
+
+#[cfg(target_os = "ios")]
+extern "C" fn lookup_cancelled(context: *const std::ffi::c_void) -> bool {
+    // SAFETY: MTAppNetworkResolve receives this private callback only with the
+    // valid, aligned AtomicBool borrowed by resolve_blocking_cancellable. It polls
+    // synchronously and never retains context, so the borrow outlives every call.
+    // The atomic load permits concurrent cancellation by the engine worker.
+    !context.is_null() && unsafe { &*context.cast::<AtomicBool>() }.load(Ordering::Acquire)
+}
